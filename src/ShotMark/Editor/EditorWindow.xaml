<Window x:Class="ShotMark.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:ShotMark.Editor"
        xmlns:ui="clr-namespace:ShotMark.UI"
        Title="ShotMark"
        Width="1360" Height="860" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True">
    <DockPanel>

        <!-- ================= Header ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource AccentButton}" Click="Capture_Click" Padding="14,7" ToolTip="Capturar região ou janela  (Print Screen)">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{x:Static ui:Icons.Capture}" Size="17" StrokeWidth="1.9"/>
                            <TextBlock Text="Capturar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="CaptureFull_Click" ToolTip="Capturar todas as telas  (Ctrl+Shift+F)">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{x:Static ui:Icons.FullScreen}" Size="17"/>
                            <TextBlock Text="Tela inteira" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CaptureMoreButton" Style="{StaticResource IconButton}" Click="CaptureMore_Click" ToolTip="Mais modos de captura">
                        <ui:Icon Data="{x:Static ui:Icons.Down}" Size="15"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Captura com atraso de 3 s" Click="Delay3_Click"/>
                                <MenuItem Header="Captura com atraso de 5 s" Click="Delay5_Click"/>
                                <MenuItem Header="Captura com atraso de 10 s" Click="Delay10_Click"/>
                                <Separator/>
                                <MenuItem Header="Repetir última região" InputGestureText="Ctrl+Shift+R" Click="RepeatRegion_Click"/>
                                <Separator/>
                                <MenuItem Header="Captura com rolagem (página longa)" Click="ScrollCapture_Click"/>
                                <MenuItem Header="Gravar vídeo da tela (MP4)" Click="RecordMp4_Click"/>
                                <MenuItem Header="Gravar GIF animado" Click="RecordGif_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Style="{StaticResource Divider}"/>

                    <Button Style="{StaticResource IconButton}" Click="Open_Click" ToolTip="Abrir projeto ou imagem  (Ctrl+O)">
                        <ui:Icon Data="{x:Static ui:Icons.Open}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Save_Click" ToolTip="Salvar na biblioteca  (Ctrl+S)">
                        <ui:Icon Data="{x:Static ui:Icons.Save}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Export_Click" ToolTip="Exportar PNG / JPG / BMP / GIF / TIFF  (Ctrl+E)">
                        <ui:Icon Data="{x:Static ui:Icons.Export}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Copy_Click" ToolTip="Copiar imagem com anotações  (Ctrl+C)">
                        <ui:Icon Data="{x:Static ui:Icons.Copy}"/>
                    </Button>

                    <Border Style="{StaticResource Divider}"/>

                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="Undo_Click" ToolTip="Desfazer  (Ctrl+Z)">
                        <ui:Icon Data="{x:Static ui:Icons.Undo}"/>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="Redo_Click" ToolTip="Refazer  (Ctrl+Y)">
                        <ui:Icon Data="{x:Static ui:Icons.Redo}"/>
                    </Button>

                    <Border Style="{StaticResource Divider}"/>

                    <Button x:Name="ImageMenuButton" Style="{StaticResource FlatButton}" Click="ImageMenu_Click" ToolTip="Girar, espelhar, redimensionar, borda e sombra">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{x:Static ui:Icons.Image}" Size="17"/>
                            <TextBlock Text="Imagem" Margin="8,0,4,0" VerticalAlignment="Center"/>
                            <ui:Icon Data="{x:Static ui:Icons.Down}" Size="12"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Girar 90° à direita" Click="RotateRight_Click"/>
                                <MenuItem Header="Girar 90° à esquerda" Click="RotateLeft_Click"/>
                                <MenuItem Header="Espelhar horizontalmente" Click="FlipH_Click"/>
                                <MenuItem Header="Espelhar verticalmente" Click="FlipV_Click"/>
                                <Separator/>
                                <MenuItem Header="Redimensionar…" Click="Resize_Click"/>
                                <Separator/>
                                <MenuItem Header="Adicionar borda (cor atual)…" Click="Border_Click"/>
                                <MenuItem Header="Adicionar sombra" Click="Shadow_Click"/>
                                <Separator/>
                                <MenuItem Header="Desfocar imagem inteira" Click="BlurAll_Click"/>
                                <MenuItem Header="Pixelar imagem inteira" Click="PixelateAll_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Pin_Click" ToolTip="Fixar na tela (fica por cima de tudo)  (Ctrl+T)">
                        <ui:Icon Data="{x:Static ui:Icons.Pin}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Print_Click" ToolTip="Imprimir  (Ctrl+P)">
                        <ui:Icon Data="{x:Static ui:Icons.Print}"/>
                    </Button>
                    <Button x:Name="DragOutButton" Style="{StaticResource IconButton}" ToolTip="Arraste daqui para soltar a imagem em outro programa (e-mail, chat, documento)"
                            PreviewMouseLeftButtonDown="DragOut_MouseDown" PreviewMouseMove="DragOut_MouseMove" Cursor="SizeAll">
                        <ui:Icon Data="{x:Static ui:Icons.Drag}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="MoreMenu_Click" ToolTip="Mais opções">
                        <ui:Icon Data="{x:Static ui:Icons.More}" StrokeWidth="3"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copiar imagem" InputGestureText="Ctrl+Shift+C" Click="CopyImage_Click"/>
                                <MenuItem Header="Copiar como arquivo" Click="CopyAsFile_Click"/>
                                <Separator/>
                                <MenuItem Header="Exportar como PDF…" Click="ExportPdf_Click"/>
                                <MenuItem Header="Mostrar na pasta" Click="RevealCurrent_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource FlatButton}" Click="Ocr_Click" ToolTip="Reconhecer o texto da captura e copiar">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{x:Static ui:Icons.Ocr}" Size="17"/>
                            <TextBlock Text="Extrair texto" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Divider}"/>
                    <Button Style="{StaticResource FlatButton}" Click="WhatsNew_Click" ToolTip="O que mudou nesta versão">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <ui:Icon Data="{x:Static ui:Icons.Sparkle}" Size="17"/>
                                <Ellipse x:Name="NewsBadge" Width="8" Height="8" Fill="{StaticResource Danger}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock Text="Novidades" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Configurações  (Ctrl+,)">
                        <ui:Icon Data="{x:Static ui:Icons.Gear}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Context bar (tool properties) ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="6,5" Height="44">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Style="{StaticResource Label}" Text="Cor" Margin="10,0,10,0"/>
                    <StackPanel x:Name="PalettePanel" Orientation="Horizontal" VerticalAlignment="Center"/>

                    <Border Style="{StaticResource Divider}" Margin="14,6,4,6"/>

                    <TextBlock Style="{StaticResource Label}" Text="Espessura"/>
                    <Slider x:Name="ThicknessSlider" Width="120" Minimum="1" Maximum="24" Value="4" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="Thickness_Changed"/>
                    <TextBlock x:Name="ThicknessText" Text="4" Width="26" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource FgMuted}"/>

                    <StackPanel x:Name="FontPanel" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="Fonte"/>
                        <Slider x:Name="FontSlider" Width="120" Minimum="10" Maximum="96" Value="24" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" ValueChanged="Font_Changed"/>
                        <TextBlock x:Name="FontText" Text="24" Width="26" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource FgMuted}"/>
                        <Button x:Name="FontFamilyButton" Style="{StaticResource FlatButton}" Padding="8,3" Margin="4,0,0,0" Click="FontFamily_Click" ToolTip="Fonte">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FontFamilyText" Text="Segoe UI" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                <ui:Icon Data="{x:Static ui:Icons.Down}" Size="12" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="FontMenu"/>
                            </Button.ContextMenu>
                        </Button>
                        <ToggleButton x:Name="BoldToggle" Style="{StaticResource LayerToggle}" Margin="4,0,0,0" ToolTip="Negrito" Click="Bold_Click" IsChecked="True">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="14"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicToggle" Style="{StaticResource LayerToggle}" Margin="2,0,0,0" ToolTip="Itálico" Click="Italic_Click">
                            <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="14"/>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="StylePanel" Orientation="Horizontal" Margin="14,0,0,0">
                        <CheckBox x:Name="DashedToggle" Style="{StaticResource Switch}" Content="Tracejado" VerticalAlignment="Center"
                                  Checked="Dashed_Changed" Unchecked="Dashed_Changed" Foreground="{StaticResource FgMuted}" FontSize="12"/>
                        <CheckBox x:Name="DoubleHeadToggle" Style="{StaticResource Switch}" Content="Ponta dupla" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Checked="DoubleHead_Changed" Unchecked="DoubleHead_Changed" Foreground="{StaticResource FgMuted}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel x:Name="StampPanel" Orientation="Horizontal" Margin="14,0,0,0">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Stamp" Tag="check" Content="✔" Padding="9,3" Checked="Stamp_Checked" IsChecked="True" ToolTip="Certo"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Stamp" Tag="cross" Content="✖" Padding="9,3" Checked="Stamp_Checked" ToolTip="Errado"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Stamp" Tag="warning" Content="⚠" Padding="9,3" Checked="Stamp_Checked" ToolTip="Atenção"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Stamp" Tag="info" Content="i" FontWeight="Bold" Padding="11,3" Checked="Stamp_Checked" ToolTip="Informação"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Stamp" Tag="question" Content="?" FontWeight="Bold" Padding="10,3" Checked="Stamp_Checked" ToolTip="Dúvida"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Stamp" Tag="star" Content="★" Padding="9,3" Checked="Stamp_Checked" ToolTip="Estrela"/>
                    </StackPanel>

                    <Button x:Name="RestartStepsButton" Style="{StaticResource FlatButton}" Padding="10,4" Margin="10,0,0,0" FontSize="12"
                            Content="Recomeçar em 1" Click="RestartSteps_Click" ToolTip="O próximo passo volta a ser 1"/>

                    <StackPanel x:Name="FillPanel" Orientation="Horizontal" Margin="14,0,0,0">
                        <CheckBox x:Name="FillToggle" Style="{StaticResource Switch}" Content="Preencher" VerticalAlignment="Center"
                                  Checked="Fill_Changed" Unchecked="Fill_Changed" Foreground="{StaticResource FgMuted}" FontSize="12"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="Opacidade"/>
                    <Slider x:Name="OpacitySlider" Width="90" Minimum="10" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="5"
                            VerticalAlignment="Center" ValueChanged="Opacity_Changed"/>
                    <TextBlock x:Name="OpacityText" Text="100%" Width="38" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource FgMuted}"/>
                </StackPanel>
                <TextBlock x:Name="ToolHint" Foreground="{StaticResource FgFaint}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="18,0,10,0"/>
            </DockPanel>
        </Border>

        <!-- ================= Status bar ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,2">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SizeText" Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Style="{StaticResource SmallIconButton}" Click="ZoomOut_Click" ToolTip="Diminuir zoom  (Ctrl+−)">
                        <ui:Icon Data="{x:Static ui:Icons.ZoomOut}" Size="15"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    <Button Style="{StaticResource SmallIconButton}" Click="ZoomIn_Click" ToolTip="Aumentar zoom  (Ctrl++)">
                        <ui:Icon Data="{x:Static ui:Icons.ZoomIn}" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource SmallIconButton}" Click="ZoomFit_Click" ToolTip="Ajustar à janela  (Ctrl+0)">
                        <ui:Icon Data="{x:Static ui:Icons.Fit}" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="7,3" FontSize="12" Content="1:1" Click="Zoom100_Click" ToolTip="Tamanho real  (Ctrl+1)"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ================= Recent captures ================= -->
        <Border DockPanel.Dock="Bottom" Height="140" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,7,10,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="8,3" FontSize="12" Click="OpenFolder_Click" ToolTip="Abrir a pasta Imagens\ShotMark">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{x:Static ui:Icons.Folder}" Size="14"/>
                            <TextBlock Text="Abrir pasta" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Grid DockPanel.Dock="Right" Width="230" Margin="0,0,8,0">
                        <TextBox x:Name="LibrarySearch" Padding="28,3,8,3" FontSize="12" TextChanged="LibrarySearch_TextChanged"
                                 ToolTip="Busca pelo nome, data ou texto dentro das capturas (OCR)"/>
                        <ui:Icon Data="{x:Static ui:Icons.Search}" Size="13" Foreground="{StaticResource FgMuted}" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="LibrarySearchHint" Text="Buscar capturas…" Foreground="{StaticResource FgFaint}" FontSize="12"
                                   VerticalAlignment="Center" Margin="29,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="RECENTES"/>
                </DockPanel>
                <ListBox x:Name="LibraryList" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Margin="8,0,8,4"
                         ItemContainerStyle="{StaticResource CardItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Library_DoubleClick" KeyDown="Library_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="112" ToolTip="{Binding Path}">
                                <Border Height="62" Background="#14FFFFFF" CornerRadius="5" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,4,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Abrir" Click="LibraryOpen_Click"/>
                            <MenuItem Header="Mostrar na pasta" Click="LibraryReveal_Click"/>
                            <Separator/>
                            <MenuItem Header="Excluir selecionadas" InputGestureText="Delete" Click="LibraryDelete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Tool rail ================= -->
        <Border DockPanel.Dock="Left" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="7,8,7,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel x:Name="ToolPanel">
                <Button x:Name="RailToggle" Style="{StaticResource IconButton}" Click="RailToggle_Click" HorizontalAlignment="Left"
                        Width="38" Height="32" Margin="0,0,0,6" ToolTip="Recolher / expandir o menu de ferramentas">
                    <ui:Icon x:Name="RailToggleIcon" Data="{x:Static ui:Icons.CollapseLeft}"/>
                </Button>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Select" ToolTip="Selecionar e mover  (V)">
                    <ui:Icon Data="{x:Static ui:Icons.Select}"/>
                </RadioButton>
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="6,4"/>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Arrow" IsChecked="True" ToolTip="Seta  (A) — Shift: 45°">
                    <ui:Icon Data="{x:Static ui:Icons.Arrow}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Line" ToolTip="Linha  (L) — Shift: 45°">
                    <ui:Icon Data="{x:Static ui:Icons.Line}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Rectangle" ToolTip="Retângulo  (R) — Shift: quadrado">
                    <ui:Icon Data="{x:Static ui:Icons.Rectangle}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Ellipse" ToolTip="Elipse  (E) — Shift: círculo">
                    <ui:Icon Data="{x:Static ui:Icons.Ellipse}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Pen" ToolTip="Caneta  (P)">
                    <ui:Icon Data="{x:Static ui:Icons.Pen}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Highlighter" ToolTip="Marca-texto  (H)">
                    <ui:Icon Data="{x:Static ui:Icons.Highlighter}"/>
                </RadioButton>
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="6,4"/>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Text" ToolTip="Texto  (T)">
                    <ui:Icon Data="{x:Static ui:Icons.Text}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Callout" ToolTip="Balão de texto  (C)">
                    <ui:Icon Data="{x:Static ui:Icons.Callout}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Step" ToolTip="Passos numerados  (N)">
                    <ui:Icon Data="{x:Static ui:Icons.Step}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Stamp" ToolTip="Carimbos: certo, errado, atenção…  (S)">
                    <ui:Icon Data="{x:Static ui:Icons.Stamp}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Magnify" ToolTip="Lupa: amplia um detalhe  (M)">
                    <ui:Icon Data="{x:Static ui:Icons.Magnify}"/>
                </RadioButton>
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="6,4"/>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Pixelate" ToolTip="Pixelizar / ocultar dados  (B)">
                    <ui:Icon Data="{x:Static ui:Icons.Pixelate}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Blur" ToolTip="Desfocar / embaçar uma área  (U)">
                    <ui:Icon Data="{x:Static ui:Icons.Blur}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Spotlight" ToolTip="Holofote: escurece tudo fora da área  (G)">
                    <ui:Icon Data="{x:Static ui:Icons.Spotlight}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolButton}" Tag="Crop" ToolTip="Recortar  (X)">
                    <ui:Icon Data="{x:Static ui:Icons.Crop}"/>
                </RadioButton>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= Layers panel ================= -->
        <Border DockPanel.Dock="Right" Width="272" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- header -->
                <DockPanel DockPanel.Dock="Top" Margin="14,12,10,8">
                    <Button x:Name="ToggleAllButton" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Click="ToggleAllLayers_Click" ToolTip="Mostrar / ocultar todas">
                        <ui:Icon x:Name="ToggleAllIcon" Data="{x:Static ui:Icons.Eye}" Size="16"/>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Data="{x:Static ui:Icons.Layers}" Size="16" Foreground="{StaticResource FgMuted}"/>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="CAMADAS" Margin="8,0,0,0"/>
                        <Border Background="{StaticResource ControlBg}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LayerCountText" Text="0" FontSize="11" Foreground="{StaticResource FgMuted}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- footer actions -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="LayerUpButton" Style="{StaticResource IconButton}" Click="LayerUp_Click" ToolTip="Trazer para frente  (Ctrl+])">
                            <ui:Icon Data="{x:Static ui:Icons.Up}" Size="17"/>
                        </Button>
                        <Button x:Name="LayerDownButton" Style="{StaticResource IconButton}" Click="LayerDown_Click" ToolTip="Enviar para trás  (Ctrl+[)">
                            <ui:Icon Data="{x:Static ui:Icons.Down}" Size="17"/>
                        </Button>
                        <Button x:Name="LayerDuplicateButton" Style="{StaticResource IconButton}" Click="LayerDuplicate_Click" ToolTip="Duplicar camada  (Ctrl+D)">
                            <ui:Icon Data="{x:Static ui:Icons.Duplicate}" Size="17"/>
                        </Button>
                        <Button x:Name="LayerRenameButton" Style="{StaticResource IconButton}" Click="LayerRename_Click" ToolTip="Renomear  (F2)">
                            <ui:Icon Data="{x:Static ui:Icons.Rename}" Size="17"/>
                        </Button>
                        <Button x:Name="LayerDeleteButton" Style="{StaticResource IconButton}" Click="LayerDelete_Click" ToolTip="Excluir camada  (Delete)">
                            <ui:Icon Data="{x:Static ui:Icons.Trash}" Size="17" Foreground="{StaticResource Danger}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- background (base image) layer -->
                <Border DockPanel.Dock="Bottom" Margin="8,0,8,8" Padding="4,3" CornerRadius="7" Background="{StaticResource PanelBg2}">
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Width="28" Height="24" CornerRadius="5" Background="#14FFFFFF" Margin="4,0,8,0" ClipToBounds="True">
                            <Image x:Name="BackgroundThumb" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="Fundo (captura)" VerticalAlignment="Center" Foreground="{StaticResource FgMuted}"/>
                        <ui:Icon Grid.Column="3" Data="{x:Static ui:Icons.Lock}" Size="14" Foreground="{StaticResource FgFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid>
                    <ListBox x:Name="LayersList" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Margin="8,0"
                             ItemContainerStyle="{StaticResource LayerItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Layers_SelectionChanged" MouseDoubleClick="Layers_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource LayerToggle}" Click="LayerVisible_Click"
                                                  ToolTip="Mostrar / ocultar">
                                        <ui:Icon Data="{Binding VisibilityIcon}" Size="15"/>
                                    </ToggleButton>
                                    <Border Grid.Column="1" Width="28" Height="24" CornerRadius="5" Background="#14FFFFFF" Margin="4,0,8,0"
                                            Opacity="{Binding RowOpacity}">
                                        <ui:Icon Data="{Binding Icon}" Size="15" Foreground="{Binding ColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeWidth="1.9"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Opacity="{Binding RowOpacity}" FontStyle="{Binding NameStyle}" ToolTip="{Binding Name}"/>
                                    <ToggleButton Grid.Column="3" Style="{StaticResource LayerToggle}" Click="LayerLock_Click"
                                                  ToolTip="Travar / destravar" Opacity="{Binding LockOpacity}">
                                        <ui:Icon Data="{Binding LockIcon}" Size="14"/>
                                    </ToggleButton>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Renomear" InputGestureText="F2" Click="LayerRename_Click"/>
                                <MenuItem Header="Duplicar" InputGestureText="Ctrl+D" Click="LayerDuplicate_Click"/>
                                <Separator/>
                                <MenuItem Header="Trazer para frente" InputGestureText="Ctrl+]" Click="LayerUp_Click"/>
                                <MenuItem Header="Enviar para trás" InputGestureText="Ctrl+[" Click="LayerDown_Click"/>
                                <Separator/>
                                <MenuItem Header="Excluir" InputGestureText="Delete" Click="LayerDelete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="LayersEmptyText" Text="Desenhe algo na captura e cada anotação aparece aqui como uma camada."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource FgFaint}" FontSize="12"
                               Margin="28,24" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================= Canvas ================= -->
        <Grid Background="{StaticResource CanvasBg}">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel" Focusable="False">
                <Grid x:Name="CanvasHost" Margin="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <Rectangle x:Name="CanvasShadow" Fill="Black" Visibility="Collapsed">
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <ed:EditorCanvas x:Name="Surface"/>
                    <Canvas x:Name="EditLayer" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </ScrollViewer>

            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
                    <ui:Icon Data="{x:Static ui:Icons.Capture}" Size="34" Foreground="{StaticResource Accent}" StrokeWidth="2"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Pronto para capturar" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Foreground="{StaticResource FgMuted}" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="20">
                    Aperte <Run FontWeight="SemiBold" Foreground="{StaticResource Fg}">Print Screen</Run> em qualquer programa,
                    <LineBreak/>arraste uma imagem para cá ou cole com <Run FontWeight="SemiBold" Foreground="{StaticResource Fg}">Ctrl+V</Run>.
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Style="{StaticResource AccentButton}" Padding="16,8" Click="Capture_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{x:Static ui:Icons.Capture}" Size="16" StrokeWidth="1.9"/>
                            <TextBlock Text="Nova captura" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="16,8" Margin="8,0,0,0" Click="Open_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{x:Static ui:Icons.Open}" Size="16"/>
                            <TextBlock Text="Abrir imagem" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
